{
  "name": "resi-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Aplikasi lokal pelacak status packing dan pengiriman pesanan TikTok Shop (J&T)",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,WEB\" -c \"blue,green\" \"npm run dev --workspace=server\" \"npm run dev --workspace=web\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:web": "npm run dev --workspace=web",
    "build:web": "npm run build --workspace=web",
    "build": "npm run build:web && node scripts/copy-dist.js",
    "start": "npm run start --workspace=server",
    "db:generate": "npm run db:generate --workspace=server",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:reset": "node scripts/reset-db.js",
    "seed:admin": "npm run seed:admin --workspace=server",
    "seed:excel": "python scripts/seed_excel_inventory.py",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.20.0",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
